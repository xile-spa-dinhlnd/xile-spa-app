              "raw": "{{baseUrl}}/api/audit-logs?entityType=app_user&entityId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "audit-logs"
              ],
              "query": [
                {
                  "key": "entityType",
                  "value": "app_user"
                },
                {
                  "key": "entityId",
                  "value": "1"
                }
              ]
            },
            "description": "Lọc theo entityType (tên bảng) và entityId. Ví dụ: nhật ký tạo tài khoản chủ tiệm."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trạng thái 200\", () => pm.response.to.have.status(200));",
                  "pm.response.json().content.forEach(r => pm.test(\"Đúng entityType\", () => pm.expect(r.entityType).to.eql(\"app_user\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Giới hạn size tối đa 100",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/audit-logs?size=5000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "audit-logs"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "5000"
                }
              ]
            },
            "description": "size lớn hơn 100 bị giới hạn về 100."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trạng thái 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"size = 100\", () => pm.expect(pm.response.json().size).to.eql(100));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Dịch vụ (S1-05)",
      "description": "Bảng giá dịch vụ (FR-SVC-01 đến 04). Mỗi lần chạy tạo một dịch vụ mới có tên kèm runId để không trùng giữa các lần chạy. Không có xóa: chỉ ngừng bán (BR-19).",
      "item": [
        {
          "name": "Danh sách nhóm dịch vụ",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/service-groups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalog",
                "service-groups"
              ]
            },
            "description": "Nhóm đang dùng, xếp theo thứ tự. Lưu id nhóm đầu và nhóm thứ hai vào biến để các request sau dùng."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trạng thái 200\", () => pm.response.to.have.status(200));",
                  "const g = pm.response.json();",
                  "pm.test(\"Có ít nhất 2 nhóm\", () => pm.expect(g.length).to.be.at.least(2));",
                  "pm.collectionVariables.set(\"groupId\", g[0].id);",
                  "pm.collectionVariables.set(\"otherGroupId\", g[1].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Tạo dịch vụ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/services",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalog",
                "services"
              ]
            },
            "description": "FR-SVC-02. Trả 201 và header Location. Tiền là số nguyên đồng.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gội thử {{runId}}\",\n  \"groupId\": {{groupId}},\n  \"durationMinutes\": 30,\n  \"listPrice\": 69000,\n  \"tourFee\": 10000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trạng thái 201\", () => pm.response.to.have.status(201));",
                  "const s = pm.response.json();",
                  "pm.collectionVariables.set(\"serviceId\", s.id);",
                  "pm.test(\"Đúng dữ liệu\", () => { pm.expect(s.listPrice).to.eql(69000); pm.expect(s.tourFee).to.eql(10000); pm.expect(s.active).to.eql(true); pm.expect(s.groupName).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Danh sách dịch vụ (không lọc)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/services",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalog",
                "services"
              ]
            },
            "description": "Gọi không kèm tham số nào (như khi mở màn hình lần đầu). Lỗi thật đã gặp: thiếu q làm API trả 500."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trạng thái 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Có ít nhất 1 dịch vụ\", () => pm.expect(pm.response.json().totalElements).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tìm dịch vụ theo tên",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/services?q=gội THỬ {{runId}}&page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalog",
                "services"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "gội THỬ {{runId}}"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "FR-SVC-01. Tìm không phân biệt hoa thường, phân trang."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trạng thái 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tìm thấy đúng 1\", () => pm.expect(pm.response.json().totalElements).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Xem một dịch vụ",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/services/{{serviceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalog",
                "services",
                "{{serviceId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trạng thái 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Đúng id\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"serviceId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sửa dịch vụ và đổi giá",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/services/{{serviceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalog",
                "services",
                "{{serviceId}}"
              ]
            },
            "description": "FR-SVC-03. Gửi đủ các trường (thay thế toàn bộ). Đổi giá thì ghi lịch sử giá; giao dịch cũ không bị ảnh hưởng.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gội thử {{runId}}\",\n  \"groupId\": {{otherGroupId}},\n  \"durationMinutes\": 45,\n  \"listPrice\": 79000,\n  \"tourFee\": 15000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trạng thái 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test(\"Giá mới và nhóm mới\", () => { pm.expect(s.listPrice).to.eql(79000); pm.expect(s.groupId).to.eql(Number(pm.collectionVariables.get(\"otherGroupId\"))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Nhật ký của dịch vụ",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/audit-logs?entityType=service&entityId={{serviceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "audit-logs"
              ],
              "query": [
                {
                  "key": "entityType",
                  "value": "service"
                },
                {
                  "key": "entityId",
                  "value": "{{serviceId}}"
                }
              ]
            },
            "description": "Mỗi thay đổi đều ghi nhật ký (BR-18): mới nhất trước."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trạng thái 200\", () => pm.response.to.have.status(200));",
                  "const c = pm.response.json().content;",
                  "pm.test(\"UPDATE rồi CREATE\", () => pm.expect(c.map(r => r.action)).to.eql([\"UPDATE\", \"CREATE\"]));",
                  "pm.test(\"Ghi giá cũ và mới\", () => { pm.expect(c[0].before.listPrice).to.eql(69000); pm.expect(c[0].after.listPrice).to.eql(79000); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ngừng bán",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/services/{{serviceId}}/deactivate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalog",
                "services",
                "{{serviceId}}",
                "deactivate"
              ]
            },
            "description": "FR-SVC-04. Gọi lại khi đã ngừng bán thì không đổi gì."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trạng thái 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"active = false\", () => pm.expect(pm.response.json().active).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lọc dịch vụ đang ngừng bán",
          "request": {
            "method": "GET",
