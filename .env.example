# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN XILE SPA
# Chép file này thành .env (đã nằm trong .gitignore) rồi điều chỉnh theo nhu cầu.
# TUYỆT ĐỐI KHÔNG commit file .env chứa mật khẩu thật lên Git (AGENTS.md quy tắc 6).
# ==============================================================================

# --- 1. Cơ sở dữ liệu PostgreSQL (docker-compose.yml và backend) ---
POSTGRES_DB=xile_spa
POSTGRES_USER=xile
POSTGRES_PASSWORD=xile_dev
POSTGRES_PORT=5433

# DB connection cho backend (mặc định lấy theo cấu hình dev trong application-dev.yml)
# DB_URL=jdbc:postgresql://localhost:5433/xile_spa
# DB_USERNAME=xile
# DB_PASSWORD=xile_dev

# --- 2. Tài khoản chủ tiệm khởi tạo ban đầu (card S1-02) ---
# APP_OWNER_EMAIL=owner@xilespa.vn
# APP_OWNER_PASSWORD=xile_dev_123
# APP_OWNER_NAME=Chủ tiệm Xile

# --- 3. Bảo mật JWT & Xác thực ---
# Khóa bí mật HMAC-SHA256 (máy dev có sẵn giá trị mặc định, lên Prod bắt buộc đổi chuỗi ngẫu nhiên >= 256-bit)
# JWT_SECRET=xile-spa-dev-secret-key-must-be-at-least-256-bits-long-for-hmac-sha256
# Bật cờ Secure cho cookie (Prod chạy HTTPS thì đặt true, dev local để false)
JWT_COOKIE_SECURE=false

# --- 4. Quên / Đặt lại mật khẩu (FR-AUTH-03, OQ-10) ---
# Đường dẫn giao diện đặt lại mật khẩu gửi cho người dùng
AUTH_RESET_PASSWORD_BASE_URL=http://localhost:5173/reset-password

# --- 5. Cấu hình gửi Email SMTP (Dùng khi kích hoạt profile Prod) ---
# Ở môi trường Dev (mặc định profile dev): Backend tự động ghi link đặt lại mật khẩu ra màn hình console / terminal.
# Ở môi trường Prod (profile prod): Cấu hình thông tin SMTP để gửi email thật tới hòm thư người dùng.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_account@gmail.com
# MAIL_PASSWORD=app_password_tao_tu_gmail
# MAIL_FROM=no-reply@xilespa.vn
