# Biến môi trường cho máy dev. Chép thành .env (đã có trong .gitignore) rồi sửa nếu cần.
# CHỈ dùng cho dev. Môi trường thật đặt bí mật riêng, không dùng các giá trị này.

# Database (docker-compose.yml)
POSTGRES_DB=xile_spa
POSTGRES_USER=xile
POSTGRES_PASSWORD=xile_dev
POSTGRES_PORT=5433

# Backend (profile dev đọc các biến này; không đặt thì dùng mặc định trong application-dev.yml)
# DB_URL=jdbc:postgresql://localhost:5433/xile_spa
# DB_USERNAME=xile
# DB_PASSWORD=xile_dev
